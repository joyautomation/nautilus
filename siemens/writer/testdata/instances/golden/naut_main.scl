FUNCTION_BLOCK "naut_main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      t1 : TON_TIME;
      t2 : TOF_TIME;
      t3 : TP_TIME;
      cu : IEC_LCOUNTER;
      cd : IEC_LCOUNTER;
      cud : IEC_LCOUNTER;
      rt : R_TRIG;
      ft : F_TRIG;
      sr1 : Struct
         S1 : Bool;
         R : Bool;
         Q1 : Bool;
      END_STRUCT;
      rs1 : Struct
         S : Bool;
         R1 : Bool;
         Q1 : Bool;
      END_STRUCT;
      a : BOOL;
      b : BOOL;
      c : BOOL;
      q1 : BOOL;
      q2 : BOOL;
      q3 : BOOL;
      q4 : BOOL;
      q5 : BOOL;
      q6 : BOOL;
      q7 : BOOL;
      v : LINT;
      w : LINT;
      e1 : TIME;
   END_VAR

BEGIN
	#a := "naut_Tags".Go;
	#b := NOT "naut_Tags".Go;
	#t1(IN := #a, PT := T#2s);
	#t1(IN := #b, PT := #t1.PT);
	#q1 := #t1.Q;
	#e1 := #t1.ET;
	#t2(IN := #a, PT := T#1s, Q => #q2);
	#t3(IN := #a, PT := T#500ms);
	#q3 := #t3.Q;
	#cu.CTU(CU := #a, R := #b, PV := 10);
	#cu.CTU(CU := #a, R := #cu.R, PV := #cu.PV);
	#q4 := #cu.QU;
	#v := #cu.CV;
	#cd.CTD(CD := #a, LD := #b, PV := 5);
	#cd.CTD(CD := #a, LD := #cd.LD, PV := #cd.PV);
	#q5 := #cd.QD;
	#w := #cd.CV;
	#cud.CTUD(CU := #a, CD := #b, R := #c, LD := #c, PV := 7);
	#q6 := #cud.QU;
	#cud.CTUD(CU := #b, CD := #cud.CD, R := #cud.R, LD := #cud.LD, PV := #cud.PV);
	#q7 := #cud.QD;
	#cu.CTU(CU := #a, R := #cu.R, PV := #v);
	#cd.CTD(CD := #a, LD := #b, PV := #w);
	#cud.CTUD(CU := #a, CD := #cud.CD, R := #cud.R, LD := #cud.LD, PV := #v);
	#v := #cud.CV;
	#rt(CLK := #a);
	#ft(CLK := #a, Q => #c);
	"naut_Tags".Out := #rt.Q OR #c;
	#sr1.S1 := #a;
	#sr1.R := #b;
	#sr1.Q1 := #sr1.S1 OR (#sr1.Q1 AND NOT #sr1.R);
	#rs1.S := #a;
	#rs1.R1 := #b;
	#rs1.Q1 := NOT #rs1.R1 AND (#rs1.S OR #rs1.Q1);
	"naut_Tags".Out := #sr1.Q1 AND #rs1.Q1;
	"naut_Tags".N := LINT_TO_DINT((((DINT_TO_LINT("naut_Tags".N) + 1) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
END_FUNCTION_BLOCK
