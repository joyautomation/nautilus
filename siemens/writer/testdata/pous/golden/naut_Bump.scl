FUNCTION "naut_Bump" : INT
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      X : INT;
   END_VAR
   VAR_TEMP 
      Bump : INT;
   END_VAR

BEGIN
	#Bump := 0;
	#Bump := LINT_TO_INT((((INT_TO_LINT(#X) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	#naut_Bump := #Bump;
END_FUNCTION
