FUNCTION "naut_ATAN2" : LReal
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Y : LReal;
      X : LReal;
   END_VAR
   VAR_TEMP 
      q : LReal;
      w : LWord;
   END_VAR

BEGIN
	// Go's math.Atan2, case by case.
	IF #Y <> #Y OR #X <> #X THEN
		#naut_ATAN2 := #Y + #X; // NaN
	ELSIF #Y = 0.0 THEN
		#w := LREAL_TO_LWORD(#X);
		IF #X >= 0.0 AND NOT #w.%X63 THEN
			#naut_ATAN2 := #Y; // ±0, Y's sign
		ELSE
			#w := LREAL_TO_LWORD(#Y);
			IF #w.%X63 THEN
				#naut_ATAN2 := -3.141592653589793;
			ELSE
				#naut_ATAN2 := 3.141592653589793;
			END_IF;
		END_IF;
	ELSIF #X = 0.0 THEN
		IF #Y < 0.0 THEN
			#naut_ATAN2 := -1.5707963267948966;
		ELSE
			#naut_ATAN2 := 1.5707963267948966;
		END_IF;
	ELSIF #X > 1.7976931348623157E+308 THEN // +inf
		IF ABS(#Y) > 1.7976931348623157E+308 THEN
			IF #Y < 0.0 THEN
				#naut_ATAN2 := -0.7853981633974483;
			ELSE
				#naut_ATAN2 := 0.7853981633974483;
			END_IF;
		ELSIF #Y < 0.0 THEN
			#naut_ATAN2 := LWORD_TO_LREAL(16#8000000000000000); // -0
		ELSE
			#naut_ATAN2 := 0.0;
		END_IF;
	ELSIF #X < -1.7976931348623157E+308 THEN // -inf
		IF ABS(#Y) > 1.7976931348623157E+308 THEN
			IF #Y < 0.0 THEN
				#naut_ATAN2 := -2.356194490192345;
			ELSE
				#naut_ATAN2 := 2.356194490192345;
			END_IF;
		ELSE
			IF #Y < 0.0 THEN
				#naut_ATAN2 := -3.141592653589793;
			ELSE
				#naut_ATAN2 := 3.141592653589793;
			END_IF;
		END_IF;
	ELSIF ABS(#Y) > 1.7976931348623157E+308 THEN
		IF #Y < 0.0 THEN
			#naut_ATAN2 := -1.5707963267948966;
		ELSE
			#naut_ATAN2 := 1.5707963267948966;
		END_IF;
	ELSE
		#q := ATAN(#Y / #X);
		IF #X < 0.0 THEN
			IF #q <= 0.0 THEN
				#naut_ATAN2 := #q + 3.141592653589793;
			ELSE
				#naut_ATAN2 := #q - 3.141592653589793;
			END_IF;
		ELSE
			#naut_ATAN2 := #q;
		END_IF;
	END_IF;
END_FUNCTION
