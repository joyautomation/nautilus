FUNCTION_BLOCK "naut_Main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      c : IEC_LCOUNTER;
      sv : Array[0..6] of LREAL;
      gv : Array[0..11] of REAL;
      i : INT;
      j : INT;
      inf : LREAL;
      nz : LREAL;
      ly : LREAL;
      lx : LREAL;
      naut_fault : "naut_Fault";
   END_VAR
   VAR_TEMP 
      naut_for_v1 : INT;
      naut_for_v2 : INT;
      naut_ix1 : LINT;
      naut_for_v3 : INT;
      naut_for_v4 : INT;
      naut_ix2 : LINT;
   END_VAR

BEGIN
	#naut_fault.faulted := FALSE;
	"naut_Tags".rA16 := LINT_TO_INT((((ABS(INT_TO_LINT("naut_Tags".A16))) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	"naut_Tags".rA32 := LINT_TO_DINT((((ABS(DINT_TO_LINT("naut_Tags".A32))) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
	"naut_Tags".rA64 := ABS("naut_Tags".A64);
	"naut_Tags".rAbs5 := LINT_TO_INT((((LINT#5) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	"naut_Tags".rAbs128 := LINT_TO_INT((((LINT#128) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	"naut_Tags".rAbs32k := LINT_TO_DINT((((LINT#32768) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
	"naut_Tags".rAbs2g := LINT#2147483648;
	IF "naut_Tags".En THEN
		"naut_Tags".rLim := LIMIT(MN := 0.0, IN := "naut_Bump"(x := "naut_Tags".X), MX := 10.0);
		"naut_Tags".eno1 := TRUE;
	ELSE
		"naut_Tags".eno1 := FALSE;
	END_IF;
	IF "naut_Tags".En THEN
		#c.CTU(CU := "naut_Tags".Cu, R := FALSE, PV := 100);
		"naut_Tags".cv := LINT_TO_INT((((#c.CV) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
		"naut_Tags".eno2 := TRUE;
	ELSE
		"naut_Tags".eno2 := FALSE;
	END_IF;
	#inf := 1.0E300 * 1.0E300;
	#nz := 0.0 * -1.0;
	#sv[0] := #nz;
	#sv[1] := 0.0;
	#sv[2] := 1.0;
	#sv[3] := -1.0;
	#sv[4] := #inf;
	#sv[5] := -#inf;
	#sv[6] := #inf - #inf;
	FOR #naut_for_v1 := 0 TO 6 DO
		#i := #naut_for_v1;
		FOR #naut_for_v2 := 0 TO 6 DO
			#j := #naut_for_v2;
			#naut_ix1 := INT_TO_LINT(#i) * 7 + INT_TO_LINT(#j);
			IF #naut_ix1 < 0 OR #naut_ix1 > 48 THEN
				#naut_fault.faulted := TRUE;
				#naut_fault.line := 44;
				#naut_fault.block := 'Main';
				RETURN;
			END_IF;
			"naut_Tags".Sp[#naut_ix1] := "naut_ATAN2"(Y := #sv[#i], X := #sv[#j]);
		END_FOR;
	END_FOR;
	#gv[0] := 0.5;
	#gv[1] := -0.5;
	#gv[2] := 3.0;
	#gv[3] := -3.0;
	#gv[4] := 0.001;
	#gv[5] := -0.001;
	#gv[6] := 100.0;
	#gv[7] := -100.0;
	#gv[8] := 0.7071;
	#gv[9] := -2.5;
	#gv[10] := 1000000.0;
	#gv[11] := -1000000.0;
	FOR #naut_for_v3 := 0 TO 11 DO
		#i := #naut_for_v3;
		FOR #naut_for_v4 := 0 TO 11 DO
			#j := #naut_for_v4;
			#naut_ix2 := INT_TO_LINT(#i) * 12 + INT_TO_LINT(#j);
			IF #naut_ix2 < 0 OR #naut_ix2 > 143 THEN
				#naut_fault.faulted := TRUE;
				#naut_fault.line := 52;
				#naut_fault.block := 'Main';
				RETURN;
			END_IF;
			"naut_Tags".Gr[#naut_ix2] := LREAL_TO_REAL("naut_ATAN2"(Y := REAL_TO_LREAL(#gv[#i]), X := REAL_TO_LREAL(#gv[#j])));
		END_FOR;
	END_FOR;
	#ly := 1.0E300;
	#lx := 1.0E-300;
	"naut_Tags".Sq[0] := "naut_ATAN2"(Y := #ly, X := #lx);
	#ly := -1.0E-300;
	#lx := 1.0E300;
	"naut_Tags".Sq[1] := "naut_ATAN2"(Y := #ly, X := #lx);
	"naut_Tags".Scans := LINT_TO_DINT((((DINT_TO_LINT("naut_Tags".Scans) + 1) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
END_FUNCTION_BLOCK
