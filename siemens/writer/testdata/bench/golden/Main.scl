FUNCTION_BLOCK "Main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      count : INT;
      pulse : R_TRIG;
      dwell : TON_TIME;
      batches : CTU_LINT;
      state : INT := 0;
      avg : REAL;
   END_VAR
   VAR RETAIN 
      total : DINT;
   END_VAR
   VAR_TEMP 
      i : INT;
   END_VAR

BEGIN
	#i := 0;
	"Tags".Heartbeat := LINT_TO_UINT(((UINT_TO_LINT("Tags".Heartbeat) + 1) MOD LINT#65536 + LINT#65536) MOD LINT#65536);
	"Tags".Echo := "Tags".Command;
	#pulse(CLK := "Tags".Start);
	#dwell(IN := "Tags".Running AND NOT "Tags".Fault, PT := T#2s);
	#batches(CU := #pulse.Q, R := "Tags".Reset, PV := 10, Q => "Tags".Done);
	IF #dwell.Q THEN
		#count := LINT_TO_INT((((INT_TO_LINT(#count) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
		#total := LINT_TO_DINT((((DINT_TO_LINT(#total) + DINT_TO_LINT(INT_TO_DINT(#count))) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
	ELSIF "Tags".Fault THEN
		#count := 0;
	ELSE
		#count := MIN(IN1 := #count, IN2 := 100);
	END_IF;
	CASE #state OF
		0:
			IF "Tags".Start THEN
				#state := 1;
			END_IF;
		1, 2:
			#state := LINT_TO_INT((((INT_TO_LINT(#state) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
		3..5:
			#state := 0;
		ELSE
			#state := 0;
	END_CASE;
	#avg := 0.0;
	FOR #i := 1 TO 4 DO
		#avg := #avg + INT_TO_REAL(#i) / 4.0;
	END_FOR;
	"Tags".Level := LIMIT(MN := 0.0, IN := "Tags".Level * 1.5 - (#avg + 2.0), MX := 100.0);
	"Tags".Running := NOT ("Tags".Fault OR "Tags".Reset) AND "Tags".Start;
END_FUNCTION_BLOCK
