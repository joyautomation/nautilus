FUNCTION_BLOCK "Main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      count : INT;
      pulse : R_TRIG;
      dwell : TON_TIME;
      batches : CTU_INT;
      state : INT := 0;
      avg : REAL;
   END_VAR
   VAR RETAIN 
      total : DINT;
   END_VAR
   VAR_TEMP 
      i : INT;
   END_VAR

BEGIN
	"Tags".Heartbeat := "Tags".Heartbeat + 1;
	"Tags".Echo := "Tags".Command;
	#pulse(CLK := "Tags".Start);
	#dwell(IN := "Tags".Running AND NOT "Tags".Fault, PT := T#2s);
	#batches(CU := #pulse.Q, R := "Tags".Reset, PV := 10, Q => "Tags".Done);
	IF #dwell.Q THEN
		#count := #count + 1;
		#total := #total + INT_TO_DINT(#count);
	ELSIF "Tags".Fault THEN
		#count := 0;
	ELSE
		#count := MIN(IN1 := #count, IN2 := 100);
	END_IF;
	CASE #state OF
		0:
			IF "Tags".Start THEN
				#state := 1;
			END_IF;
		1, 2:
			#state := #state + 1;
		3..5:
			#state := 0;
		ELSE
			#state := 0;
	END_CASE;
	#avg := 0.0;
	FOR #i := 1 TO 4 DO
		#avg := #avg + INT_TO_REAL(#i) / 4.0;
	END_FOR;
	"Tags".Level := LIMIT(MN := 0.0, IN := "Tags".Level * 1.5 - (#avg + 2.0), MX := 100.0);
	"Tags".Running := NOT ("Tags".Fault OR "Tags".Reset) AND "Tags".Start;
END_FUNCTION_BLOCK
