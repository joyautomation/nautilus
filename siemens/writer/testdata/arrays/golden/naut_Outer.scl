FUNCTION_BLOCK "naut_Outer"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      k : INT;
   END_VAR
   VAR_OUTPUT 
      y : REAL;
   END_VAR
   VAR 
      g : "naut_Grid";
      naut_fault : "naut_Fault";
   END_VAR

BEGIN
	#naut_fault.faulted := FALSE;
	#g(k := #k, x := 2.0);
	IF #g.naut_fault.faulted THEN
		#naut_fault := #g.naut_fault;
		RETURN;
	END_IF;
	#y := #g.y;
END_FUNCTION_BLOCK
