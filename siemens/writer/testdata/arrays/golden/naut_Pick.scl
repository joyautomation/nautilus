FUNCTION "naut_Pick" : REAL
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      k : INT;
      t : Array[1..3] of REAL;
   END_VAR
   VAR_TEMP 
      Pick : REAL;
      naut_ix1 : LINT;
   END_VAR

BEGIN
	#Pick := 0.0;
	#naut_ix1 := #k;
	IF #naut_ix1 < 1 OR #naut_ix1 > 3 THEN
		"naut_Faults".scan.faulted := TRUE;
		"naut_Faults".scan.line := 16;
		"naut_Faults".scan.block := 'Pick';
		#naut_Pick := #Pick;
		RETURN;
	END_IF;
	#Pick := #t[#naut_ix1];
	#naut_Pick := #Pick;
END_FUNCTION
