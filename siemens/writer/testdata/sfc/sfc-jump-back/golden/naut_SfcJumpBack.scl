FUNCTION_BLOCK "naut_SfcJumpBack"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      _S_Idle_X : BOOL := TRUE;
      _S_S1_X : BOOL;
      _S_S1_prev : BOOL;
      _S_S2_X : BOOL;
      _S_S3_X : BOOL;
      _S_Hold_X : BOOL;
      _S_Hold_prev : BOOL;
      _en_t_go : BOOL;
      _f_t_go : BOOL;
      _en_t_s12 : BOOL;
      _f_t_s12 : BOOL;
      _en_t_s23 : BOOL;
      _f_t_s23 : BOOL;
      _en_t_loop : BOOL;
      _f_t_loop : BOOL;
      _en_t_park : BOOL;
      _f_t_park : BOOL;
      _en_t_exit : BOOL;
      _f_t_exit : BOOL;
      _en_t_tick : BOOL;
      _f_t_tick : BOOL;
      _en_t_rel : BOOL;
      _f_t_rel : BOOL;
      _act_sfc_Idle_lvl : BOOL;
      _act_sfc_S1_lvl : BOOL;
      _act_sfc_S2_lvl : BOOL;
      _act_sfc_S3_lvl : BOOL;
      _act_sfc_Hold_lvl : BOOL;
   END_VAR

BEGIN
	#_en_t_go := #_S_Idle_X AND "naut_Tags".go;
	#_en_t_s12 := #_S_S1_X AND TRUE;
	#_en_t_s23 := #_S_S2_X AND TRUE;
	#_en_t_loop := #_S_S3_X AND "naut_Tags".loop;
	#_en_t_park := #_S_S3_X AND "naut_Tags".park;
	#_en_t_exit := #_S_S3_X AND NOT "naut_Tags".loop;
	#_en_t_tick := #_S_Hold_X AND "naut_Tags".tick;
	#_en_t_rel := #_S_Hold_X AND NOT "naut_Tags".tick;
	#_f_t_go := #_en_t_go;
	#_f_t_s12 := #_en_t_s12;
	#_f_t_s23 := #_en_t_s23;
	#_f_t_loop := #_en_t_loop;
	#_f_t_park := #_en_t_park AND NOT #_f_t_loop;
	#_f_t_exit := #_en_t_exit AND NOT (#_f_t_loop OR #_f_t_park);
	#_f_t_tick := #_en_t_tick;
	#_f_t_rel := #_en_t_rel AND NOT #_f_t_tick;
	IF #_f_t_go THEN
		#_S_Idle_X := FALSE;
	END_IF;
	IF #_f_t_s12 THEN
		#_S_S1_X := FALSE;
	END_IF;
	IF #_f_t_s23 THEN
		#_S_S2_X := FALSE;
	END_IF;
	IF #_f_t_loop THEN
		#_S_S3_X := FALSE;
	END_IF;
	IF #_f_t_park THEN
		#_S_S3_X := FALSE;
	END_IF;
	IF #_f_t_exit THEN
		#_S_S3_X := FALSE;
	END_IF;
	IF #_f_t_tick THEN
		#_S_Hold_X := FALSE;
	END_IF;
	IF #_f_t_rel THEN
		#_S_Hold_X := FALSE;
	END_IF;
	IF #_f_t_go THEN
		#_S_S1_X := TRUE;
	END_IF;
	IF #_f_t_s12 THEN
		#_S_S2_X := TRUE;
	END_IF;
	IF #_f_t_s23 THEN
		#_S_S3_X := TRUE;
	END_IF;
	IF #_f_t_loop THEN
		#_S_S1_X := TRUE;
	END_IF;
	IF #_f_t_park THEN
		#_S_Hold_X := TRUE;
	END_IF;
	IF #_f_t_exit THEN
		#_S_Idle_X := TRUE;
	END_IF;
	IF #_f_t_tick THEN
		#_S_Hold_X := TRUE;
	END_IF;
	IF #_f_t_rel THEN
		#_S_Idle_X := TRUE;
	END_IF;
	IF #_S_S1_X AND NOT #_S_S1_prev THEN
		"naut_Tags".sfc_laps := LINT_TO_INT((((INT_TO_LINT("naut_Tags".sfc_laps) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	IF #_S_Hold_X AND NOT #_S_Hold_prev THEN
		"naut_Tags".sfc_holdentries := LINT_TO_INT((((INT_TO_LINT("naut_Tags".sfc_holdentries) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	IF #_act_sfc_Idle_lvl AND NOT #_S_Idle_X THEN
		"naut_Tags".sfc_idle := FALSE;
	END_IF;
	IF #_S_Idle_X THEN
		"naut_Tags".sfc_idle := TRUE;
	END_IF;
	#_act_sfc_Idle_lvl := #_S_Idle_X;
	IF #_act_sfc_S1_lvl AND NOT #_S_S1_X THEN
		"naut_Tags".sfc_s1 := FALSE;
	END_IF;
	IF #_S_S1_X THEN
		"naut_Tags".sfc_s1 := TRUE;
	END_IF;
	#_act_sfc_S1_lvl := #_S_S1_X;
	IF #_act_sfc_S2_lvl AND NOT #_S_S2_X THEN
		"naut_Tags".sfc_s2 := FALSE;
	END_IF;
	IF #_S_S2_X THEN
		"naut_Tags".sfc_s2 := TRUE;
	END_IF;
	#_act_sfc_S2_lvl := #_S_S2_X;
	IF #_act_sfc_S3_lvl AND NOT #_S_S3_X THEN
		"naut_Tags".sfc_s3 := FALSE;
	END_IF;
	IF #_S_S3_X THEN
		"naut_Tags".sfc_s3 := TRUE;
	END_IF;
	#_act_sfc_S3_lvl := #_S_S3_X;
	IF #_act_sfc_Hold_lvl AND NOT #_S_Hold_X THEN
		"naut_Tags".sfc_hold := FALSE;
	END_IF;
	IF #_S_Hold_X THEN
		"naut_Tags".sfc_hold := TRUE;
	END_IF;
	#_act_sfc_Hold_lvl := #_S_Hold_X;
	#_S_S1_prev := #_S_S1_X;
	#_S_Hold_prev := #_S_Hold_X;
END_FUNCTION_BLOCK
