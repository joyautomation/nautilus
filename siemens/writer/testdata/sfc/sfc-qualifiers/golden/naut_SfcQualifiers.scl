FUNCTION_BLOCK "naut_SfcQualifiers"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      _S_Idle_X : BOOL := TRUE;
      _S_A_X : BOOL;
      _S_A_prev : BOOL;
      _S_B_X : BOOL;
      _en_t_go : BOOL;
      _f_t_go : BOOL;
      _en_t_next : BOOL;
      _f_t_next : BOOL;
      _en_t_back : BOOL;
      _f_t_back : BOOL;
      _act_sfc_S_stored : BOOL;
      _act_sfc_R_stored : BOOL;
      _act_BumpLevel_prev : BOOL;
      _act_sfc_N_lvl : BOOL;
      _act_sfc_P1_lvl : BOOL;
      _act_sfc_P_lvl : BOOL;
      _act_sfc_P0_lvl : BOOL;
   END_VAR

BEGIN
	#_en_t_go := #_S_Idle_X AND "naut_Tags".go;
	#_en_t_next := #_S_A_X AND "naut_Tags".next;
	#_en_t_back := #_S_B_X AND "naut_Tags".back;
	#_f_t_go := #_en_t_go;
	#_f_t_next := #_en_t_next;
	#_f_t_back := #_en_t_back;
	IF #_f_t_go THEN
		#_S_Idle_X := FALSE;
	END_IF;
	IF #_f_t_next THEN
		#_S_A_X := FALSE;
	END_IF;
	IF #_f_t_back THEN
		#_S_B_X := FALSE;
	END_IF;
	IF #_f_t_go THEN
		#_S_A_X := TRUE;
	END_IF;
	IF #_f_t_next THEN
		#_S_B_X := TRUE;
	END_IF;
	IF #_f_t_back THEN
		#_S_Idle_X := TRUE;
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		#_act_sfc_S_stored := TRUE;
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		#_act_sfc_R_stored := FALSE;
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		"naut_Tags".sfc_cntp1 := LINT_TO_INT((((INT_TO_LINT("naut_Tags".sfc_cntp1) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		"naut_Tags".sfc_cntp := LINT_TO_INT((((INT_TO_LINT("naut_Tags".sfc_cntp) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	IF #_S_A_prev AND NOT #_S_A_X THEN
		"naut_Tags".sfc_cntp0 := LINT_TO_INT((((INT_TO_LINT("naut_Tags".sfc_cntp0) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	IF #_S_A_X OR #_act_BumpLevel_prev THEN
		"naut_Tags".sfc_level := LINT_TO_INT((((INT_TO_LINT("naut_Tags".sfc_level) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	#_act_BumpLevel_prev := #_S_A_X;
	IF #_act_sfc_N_lvl AND NOT #_S_A_X THEN
		"naut_Tags".sfc_n := FALSE;
	END_IF;
	IF #_S_A_X THEN
		"naut_Tags".sfc_n := TRUE;
	END_IF;
	#_act_sfc_N_lvl := #_S_A_X;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		"naut_Tags".sfc_s := TRUE;
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		"naut_Tags".sfc_r := FALSE;
	END_IF;
	IF #_act_sfc_P1_lvl AND NOT (#_S_A_X AND NOT #_S_A_prev) THEN
		"naut_Tags".sfc_p1 := FALSE;
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		"naut_Tags".sfc_p1 := TRUE;
	END_IF;
	#_act_sfc_P1_lvl := #_S_A_X AND NOT #_S_A_prev;
	IF #_act_sfc_P_lvl AND NOT (#_S_A_X AND NOT #_S_A_prev) THEN
		"naut_Tags".sfc_p := FALSE;
	END_IF;
	IF #_S_A_X AND NOT #_S_A_prev THEN
		"naut_Tags".sfc_p := TRUE;
	END_IF;
	#_act_sfc_P_lvl := #_S_A_X AND NOT #_S_A_prev;
	IF #_act_sfc_P0_lvl AND NOT (#_S_A_prev AND NOT #_S_A_X) THEN
		"naut_Tags".sfc_p0 := FALSE;
	END_IF;
	IF #_S_A_prev AND NOT #_S_A_X THEN
		"naut_Tags".sfc_p0 := TRUE;
	END_IF;
	#_act_sfc_P0_lvl := #_S_A_prev AND NOT #_S_A_X;
	#_S_A_prev := #_S_A_X;
END_FUNCTION_BLOCK
