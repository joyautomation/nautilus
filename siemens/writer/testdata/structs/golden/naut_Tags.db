   VAR RETAIN
      WL102 : Struct
         Pump : Struct
            Run : BOOL;
            Speed : REAL := 50.0;
            Starts : INT;
         END_STRUCT;
         Depth : REAL;
         "Static" : REAL;
         "Name" : DINT := 7;
      END_STRUCT;
   END_VAR

BEGIN

