FUNCTION_BLOCK "naut_Main"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      spare : "naut_Motor";
      last : "naut_Motor";
   END_VAR
   VAR_TEMP 
      t : "naut_Motor";
   END_VAR

BEGIN
	#t.Run := FALSE;
	#t.Speed := 50.0;
	#t.Starts := 0;
	IF "naut_Tags".WL101.Pump.Run AND NOT #last.Run THEN
		"naut_Tags".WL101.Pump.Starts := LINT_TO_INT((((INT_TO_LINT("naut_Tags".WL101.Pump.Starts) + 1) + LINT#32768) MOD LINT#65536 + LINT#65536) MOD LINT#65536 - LINT#32768);
	END_IF;
	#last := "naut_Tags".WL101.Pump;
	#t.Speed := "naut_Tags".WL101.Pump.Speed * 2.0;
	#spare.Speed := #t.Speed;
	"naut_Tags".WL102."Static" := "naut_Tags".WL101."Static";
	"naut_Tags".WL102."Name" := LINT_TO_DINT((((DINT_TO_LINT("naut_Tags".WL101."Name") + 1) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
END_FUNCTION_BLOCK
