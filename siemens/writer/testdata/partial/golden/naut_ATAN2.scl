FUNCTION "naut_ATAN2" : LReal
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Y : LReal;
      X : LReal;
   END_VAR
   VAR_TEMP 
      q : LReal;
      wy : LWord;
      wx : LWord;
   END_VAR

BEGIN
	// Go's math.Atan2, case by case, on the bit patterns.
	#wy := LREAL_TO_LWORD(#Y);
	#wx := LREAL_TO_LWORD(#X);
	IF #Y <> #Y OR #X <> #X THEN
		#naut_ATAN2 := #Y + #X; // NaN
	ELSIF #Y = 0.0 THEN
		IF #X >= 0.0 AND NOT #wx.%X63 THEN
			#naut_ATAN2 := #Y; // ±0, Y's sign
		ELSIF #wy.%X63 THEN
			#naut_ATAN2 := -LWORD_TO_LREAL(16#400921FB54442D18);
		ELSE
			#naut_ATAN2 := LWORD_TO_LREAL(16#400921FB54442D18);
		END_IF;
	ELSIF #X = 0.0 THEN
		IF #Y < 0.0 THEN
			#naut_ATAN2 := -LWORD_TO_LREAL(16#3FF921FB54442D18);
		ELSE
			#naut_ATAN2 := LWORD_TO_LREAL(16#3FF921FB54442D18);
		END_IF;
	ELSIF (#wx AND 16#7FF0000000000000) = 16#7FF0000000000000 AND NOT #wx.%X63 THEN // +inf
		IF (#wy AND 16#7FF0000000000000) = 16#7FF0000000000000 THEN
			IF #Y < 0.0 THEN
				#naut_ATAN2 := -LWORD_TO_LREAL(16#3FE921FB54442D18);
			ELSE
				#naut_ATAN2 := LWORD_TO_LREAL(16#3FE921FB54442D18);
			END_IF;
		ELSIF #Y < 0.0 THEN
			#naut_ATAN2 := LWORD_TO_LREAL(16#8000000000000000); // -0
		ELSE
			#naut_ATAN2 := 0.0;
		END_IF;
	ELSIF (#wx AND 16#7FF0000000000000) = 16#7FF0000000000000 THEN // -inf
		IF (#wy AND 16#7FF0000000000000) = 16#7FF0000000000000 THEN
			IF #Y < 0.0 THEN
				#naut_ATAN2 := -LWORD_TO_LREAL(16#4002D97C7F3321D2);
			ELSE
				#naut_ATAN2 := LWORD_TO_LREAL(16#4002D97C7F3321D2);
			END_IF;
		ELSE
			IF #Y < 0.0 THEN
				#naut_ATAN2 := -LWORD_TO_LREAL(16#400921FB54442D18);
			ELSE
				#naut_ATAN2 := LWORD_TO_LREAL(16#400921FB54442D18);
			END_IF;
		END_IF;
	ELSIF (#wy AND 16#7FF0000000000000) = 16#7FF0000000000000 THEN
		IF #Y < 0.0 THEN
			#naut_ATAN2 := -LWORD_TO_LREAL(16#3FF921FB54442D18);
		ELSE
			#naut_ATAN2 := LWORD_TO_LREAL(16#3FF921FB54442D18);
		END_IF;
	ELSE
		#q := ATAN(#Y / #X);
		IF #X < 0.0 THEN
			IF #q <= 0.0 THEN
				#naut_ATAN2 := #q + LWORD_TO_LREAL(16#400921FB54442D18);
			ELSE
				#naut_ATAN2 := #q - LWORD_TO_LREAL(16#400921FB54442D18);
			END_IF;
		ELSE
			#naut_ATAN2 := #q;
		END_IF;
	END_IF;
END_FUNCTION
