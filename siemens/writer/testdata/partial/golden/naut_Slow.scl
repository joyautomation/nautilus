FUNCTION_BLOCK "naut_Slow"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	"naut_Tags".SlowN := LINT_TO_DINT((((DINT_TO_LINT("naut_Tags".SlowN) + 1) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648);
	"naut_Scan_slow".tags.Sh.%B1 := DINT_TO_BYTE(LINT_TO_DINT((((DINT_TO_LINT("naut_Tags".SlowN) MOD 256) + LINT#2147483648) MOD LINT#4294967296 + LINT#4294967296) MOD LINT#4294967296 - LINT#2147483648));
	"naut_Scan_slow".assigned.Sh.%B1 := BYTE#16#FF;
END_FUNCTION_BLOCK
