PROGRAM {{.Program}}
(* Your control sequence as an SFC chart. Steps hold state; transitions
   move the token when their condition becomes true; actions (qualifiers
   N/S/R/P1/...) drive outputs while a step is active. Open the diagram:
   VS Code → right-click program.sfc → "Open With → SFC Diagram".
   This starter chart is a single always-active step (no transitions yet)
   so it uses the same Sensor/Setpoint/Actuator tags every other starter
   program does — replace Track with your real sequence (INITIAL_STEP +
   STEPs + TRANSITIONs) once there is more than one continuously running
   action. *)
VAR_EXTERNAL
    Sensor   : REAL;  (* field input — {{if .NoGo}}bound by the driver in nautilus.yaml{{else}}see driver.go{{end}} *)
    Setpoint : REAL;  (* operator value — {{if .NoGo}}declared in nautilus.yaml{{else}}seeded in main.go{{end}} *)
    Actuator : REAL;  (* field output *)
END_VAR
SFC

  INITIAL_STEP Track:
    N  UpdateActuator;
  END_STEP

  ACTION UpdateActuator:
    Actuator := LIMIT(0.0, Setpoint - Sensor, 100.0);
  END_ACTION

END_SFC
END_PROGRAM
