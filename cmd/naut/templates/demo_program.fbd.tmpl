PROGRAM {{.Program}}
(* Control for the heated tank, as an FBD netlist: a seal-in latch for the
   pump, a PI loop whose integral feeds back through a retained variable,
   a TON on-delay for the low-temperature alarm, and the RateOfChange block
   from blocks.st called like any built-in.

   Open the diagram: VS Code -> right-click program.fbd ->
   "Open With -> FBD Diagram". With the controller running, live values
   paint the wires; every gesture in the editor is a structural edit to
   this text. *)
VAR_EXTERNAL
    (* process values — produced by the sim task (sim.st) *)
    LevelPct       : REAL;
    TempC          : REAL;
    ScanDtS        : REAL;
    (* operator setpoints — writable from the dashboard and the tag API *)
    TempSP         : REAL;
    TempLowSP      : REAL;
    Kp             : REAL;
    Ki             : REAL;
    PumpStartLevel : REAL;
    PumpStopLevel  : REAL;
    (* commands + computed state *)
    PumpRun        : BOOL;
    Heater         : REAL;
    TempLowAlm     : BOOL;
    TempRate       : REAL;
END_VAR
VAR
    integral : REAL;
END_VAR
FBD
  NETWORK 'P-101 pump: level hysteresis seal-in'
  // start when low, seal through PumpRun itself, drop out when high
  low  = LE(LevelPct, PumpStartLevel)
  high = GE(LevelPct, PumpStopLevel)
  PumpRun := AND(OR(low, PumpRun), NOT high)

  NETWORK 'TIC-101: temperature PI with anti-windup'
  // the integral is retained state, fed back from its own coil
  e = SUB(TempSP, TempC)
  iStep = MUL(Ki, e, ScanDtS)
  integral := LIMIT(0.0, ADD(integral, iStep), 100.0)
  pTerm = MUL(Kp, e)
  Heater := LIMIT(0.0, ADD(pTerm, integral), 100.0)

  NETWORK 'TAL-101: low temperature, 10 s on-delay'
  // delayed so a transient dip doesn't annunciate; `naut test` asserts
  // this delay exactly
  cold = LT(TempC, TempLowSP)
  a1 : TON(IN := cold, PT := T#10S)
  TempLowAlm := a1.Q

  NETWORK 'Temperature rate of change'
  // a user FUNCTION_BLOCK from blocks.st, instantiated like a built-in
  roc : RateOfChange(IN := TempC, DT := ScanDtS)
  TempRate := roc.OUT
END_FBD
END_PROGRAM
