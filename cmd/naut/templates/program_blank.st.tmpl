PROGRAM {{.Program}}
(* Your control logic. VAR_EXTERNAL tags are bound by the runtime each
   scan: field inputs are written before the scan, outputs collected
   after. VAR is program state, retained across scans. *)
VAR_EXTERNAL
    Sensor   : REAL;  (* field input — {{if .NoGo}}bound by the driver in nautilus.yaml{{else}}see driver.go{{end}} *)
    Setpoint : REAL;  (* operator value — {{if .NoGo}}declared in nautilus.yaml{{else}}seeded in main.go{{end}} *)
    Actuator : REAL;  (* field output *)
END_VAR
VAR
    err : REAL;
END_VAR

err := Setpoint - Sensor;
Actuator := LIMIT(0.0, err, 100.0);
END_PROGRAM
