PROGRAM {{.Program}}
(* Your interlock logic as ladder. Rung grammar: series = AND,
   [ a | b ] = OR branch, /x = NC contact, ( x ) coil, ( S x )/( R x )
   latch/unlatch, FN(args) comparison contact, inst:TYPE(args) block.
   Open the diagram: VS Code → right-click program.ld →
   "Open With → Ladder Diagram". *)
VAR_EXTERNAL
    Sensor   : REAL;  (* field input — {{if .NoGo}}bound by the driver in nautilus.yaml{{else}}see driver.go{{end}} *)
    Setpoint : REAL;  (* operator value — {{if .NoGo}}declared in nautilus.yaml{{else}}seeded in main.go{{end}} *)
    Alarm    : BOOL;  (* field output *)
END_VAR
LD
  RUNG high (* alarm when the sensor exceeds the setpoint *)
    GT(Sensor, Setpoint) ( Alarm )
END_LD
END_PROGRAM
