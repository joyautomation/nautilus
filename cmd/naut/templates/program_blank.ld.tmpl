PROGRAM {{.Program}}
(* Your interlock logic as ladder. Rung grammar: series = AND,
   [ a | b ] = OR branch, /x = NC contact, +x / -x = rising / falling
   edge (true for one scan), ( x ) coil, ( S x )/( R x ) latch/unlatch,
   FN(args) comparison contact, inst:TYPE(args) block.
   Open the diagram: VS Code → right-click program.ld →
   "Open With → Ladder Diagram".{{if .NoGo}}
   The tags in nautilus.yaml are in scope as they are — no declaration
   needed; a VAR_EXTERNAL naming one stays legal and must agree with
   its type:.{{end}} *)
{{- if not .NoGo}}
VAR_EXTERNAL
    Sensor   : REAL;  (* field input — see driver.go *)
    Setpoint : REAL;  (* operator value — seeded in main.go *)
    Alarm    : BOOL;  (* field output *)
END_VAR
{{- end}}
LD
  RUNG high (* alarm when the sensor exceeds the setpoint *)
    GT(Sensor, Setpoint) ( Alarm )
END_LD
END_PROGRAM
