PROGRAM {{.Program}}
(* Heated surge tank: pump holds level by hysteresis, a PI loop holds
   temperature. VAR_EXTERNAL tags are bound by the runtime each scan —
   field inputs written before, outputs collected after. VAR is retained. *)
VAR_EXTERNAL
    (* field inputs *)
    LevelPct       : REAL;
    TempC          : REAL;
    ScanDtS        : REAL;
    (* operator setpoints *)
    TempSP         : REAL;
    Kp             : REAL;
    Ki             : REAL;
    PumpStartLevel : REAL;
    PumpStopLevel  : REAL;
    (* field outputs *)
    PumpRun        : BOOL;
    Heater         : REAL;
END_VAR
VAR
    tic : PI; (* from blocks.st — instance state (the integral) is retained *)
END_VAR

(* P-101: level hysteresis latch *)
IF LevelPct <= PumpStartLevel THEN
    PumpRun := TRUE;
ELSIF LevelPct >= PumpStopLevel THEN
    PumpRun := FALSE;
END_IF;

(* TIC-101: temperature PI — the controller itself lives in blocks.st *)
tic(SP := TempSP, PV := TempC, KP := Kp, KI := Ki, DT := ScanDtS);
Heater := tic.OUT;
END_PROGRAM
