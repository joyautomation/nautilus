<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[a note above the rung travels into the Logix rung comment
seal-in with a stop]]>
</Comment>
<Text>
<![CDATA[[XIC(Start) ,XIC(Run) ]XIO(Stop)OTE(Run);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GE(Level,HiSP)NE(Counts,0)OTE(Fault);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[nested branches, a one-shot at the head]]>
</Comment>
<Text>
<![CDATA[XIC(Start)ONS(rt_nested_Start)[XIC(Remote) [XIO(Auto) ,XIC(Bits[1]) ] ,XIC(Local) ]OTE(Ready);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Local)OSR(rt_edges_Local,rt_edges_Local_Q);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Remote)OSF(ft_edges_Remote,ft_edges_Remote_Q);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[edges away from the head take a helper rung each]]>
</Comment>
<Text>
<![CDATA[XIC(Auto)XIC(rt_edges_Local_Q)XIC(ft_edges_Remote_Q)OTE(Pulse);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[timer in series: power continues from the done bit]]>
</Comment>
<Text>
<![CDATA[XIC(Run)TON(t1,?,?)XIC(t1.DN)OTE(Dwelling);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOVE(Dwell,t2.PRE);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[a TOF ends its rung; what follows moves to a continuation]]>
</Comment>
<Text>
<![CDATA[XIC(Run)TOF(t2,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(t2.DN)XIO(Fault)OTE(Dropped);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOVE(Target,c1.PRE);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[counter with a reset and a variable preset]]>
</Comment>
<Text>
<![CDATA[XIC(Done)ONS(rt_count_Done)CTU(c1,?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(c1.DN)[OTL(Over) ,OTU(Maint) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Reset)RES(c1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Done)CTU(c2,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(c2.DN)OTE(Done);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[rewritten members]]>
</Comment>
<Text>
<![CDATA[[XIC(t1.DN) ,XIO(c1.DN) ]GT(t1.ACC,500)LT(c1.ACC,Target)XIC(Bits[3])OTE(Maint);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[a block as the rung's last element]]>
</Comment>
<Text>
<![CDATA[XIC(Fault)TON(t3,?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[assignments: one instruction per shape, CPT for the rest]]>
</Comment>
<Text>
<![CDATA[XIC(Run)ADD(Counts,1,Counts)MOVE(5,Target)ABS(Big,Big)CPT(Level,(Level + HiSP) / 2.0)OTE(Ready);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[a compare with an expression operand is a CMP]]>
</Comment>
<Text>
<![CDATA[CMP(Level + 1.0 > HiSP)CMP(Counts MOD 2 <> 0)MOVE(0,Steps);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
