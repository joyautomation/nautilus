<Routines>
<Routine Name="MainRoutine" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[IF (Level > HiSP) THEN]]>
</Line>
<Line Number="1">
<![CDATA[  HiAlm := 1;]]>
</Line>
<Line Number="2">
<![CDATA[ELSIF (Level < (HiSP - 10.0)) THEN]]>
</Line>
<Line Number="3">
<![CDATA[  HiAlm := 0;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[Pump.Speed := (Level * 2.0);]]>
</Line>
<Line Number="6">
<![CDATA[Pump.Running := HiAlm;]]>
</Line>
<Line Number="7">
<![CDATA[CASE Cmd OF]]>
</Line>
<Line Number="8">
<![CDATA[  0:]]>
</Line>
<Line Number="9">
<![CDATA[    State := 1;]]>
</Line>
<Line Number="10">
<![CDATA[  1:]]>
</Line>
<Line Number="11">
<![CDATA[    State := 10;]]>
</Line>
<Line Number="12">
<![CDATA[  2:]]>
</Line>
<Line Number="13">
<![CDATA[    State := 11;]]>
</Line>
<Line Number="14">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="15">
<![CDATA[StateNo := State;]]>
</Line>
<Line Number="16">
<![CDATA[Count := 0;]]>
</Line>
<Line Number="17">
<![CDATA[FOR i := 1 TO 3 DO]]>
</Line>
<Line Number="18">
<![CDATA[  Count := (Count + i);]]>
</Line>
<Line Number="19">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="20">
<![CDATA[t.PRE := 2000;]]>
</Line>
<Line Number="21">
<![CDATA[t.TimerEnable := Run;]]>
</Line>
<Line Number="22">
<![CDATA[t.Reset := NOT (Run);]]>
</Line>
<Line Number="23">
<![CDATA[TONR(t);]]>
</Line>
<Line Number="24">
<![CDATA[Delayed := t.DN;]]>
</Line>
</STContent>
</Routine>
