{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		// src/lib/*.test.ts import their subject as ./x.ts, as Node's type
		// stripping (npm test) needs; nothing is emitted, so this is safe.
		"allowImportingTsExtensions": true
	}
}
