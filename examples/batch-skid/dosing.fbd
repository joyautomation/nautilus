PROGRAM Dosing
(* Two dosing-line totalizers and the jacket temperature loop (TIC-201).
   Pure signal flow — the physics that produces FIT201A_Flow/FIT201B_Flow
   and TT201_Temp lives in sim.st (bench) or the field instruments
   (line.yaml); this program only ever reads them. Open the diagram:
   right-click -> "Open With -> FBD Diagram". *)
VAR_EXTERNAL
    FIT201A_Flow : REAL;
    FIT201B_Flow : REAL;
    ResetTotals  : BOOL;
    Batch        : BatchStatus;
    Active       : Recipe;
    TT201_Temp   : REAL;
    HeatingActive: BOOL;
    Kp           : REAL;
    Ki           : REAL;
    Kd           : REAL;
    TCV201_Pos   : REAL;
    DosingDtS    : REAL;
    OvertempAlm  : BOOL;
END_VAR
FBD
  // Dosing-line totalizers: liters = flow (L/min) * dt (s) / 60, held at
  // zero for the one scan Prep sets ResetTotals (see phases.sfc).
  Batch.ChargedA_L := SEL(ResetTotals, ADD(Batch.ChargedA_L, MUL(FIT201A_Flow, DIV(DosingDtS, 60.0))), 0.0)
  Batch.ChargedB_L := SEL(ResetTotals, ADD(Batch.ChargedB_L, MUL(FIT201B_Flow, DIV(DosingDtS, 60.0))), 0.0)

  // TIC-201: jacket water control valve. Reverse acting (DIRECT := FALSE):
  // TCV opens further as temperature falls below setpoint, the PID doc's
  // own "heater" case. AUTO tracks Heat and Hold together — HeatingActive
  // is written N-qualified from both steps in phases.sfc, which OR-combine
  // onto one tag the same way an SFC's own N-qualified "running" lamp
  // does — several steps writing the same tag, true whenever any one of
  // them is active (see examples/tank-batch-sfc's RunLamp).
  tic : PID(AUTO := HeatingActive, PV := TT201_Temp, SP := Active.TempSP_C,
            KP := Kp, KI := Ki, KD := Kd, CV_MIN := 0.0, CV_MAX := 100.0,
            DIRECT := FALSE, DT := DosingDtS)
  TCV201_Pos := tic.CV

  // Overtemp seal-in: latch 5 degrees above setpoint, clear once 5 degrees
  // below it — the same hysteresis shape as lift-station's HighLevelAlm.
  hiTemp = GE(TT201_Temp, ADD(Active.TempSP_C, 5.0))
  loTemp = LE(TT201_Temp, Active.TempSP_C)
  OvertempAlm := AND(OR(hiTemp, OvertempAlm), NOT loTemp)
END_FBD
END_PROGRAM
