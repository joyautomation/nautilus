<?xml version="1.0" encoding="utf-8"?>
<!-- The Logix Designer SDK's client package is not on nuget.org. The
     installer drops the .nupkg beside its examples, so that directory is a
     package source. LOGIXD_SDK_PACKAGE_DIR overrides it on a machine that
     installed the SDK somewhere else. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="LogixDesignerSDK-Source" value="C:\Users\Public\Documents\Studio 5000\Logix Designer SDK\dotnet" />
  </packageSources>
</configuration>
