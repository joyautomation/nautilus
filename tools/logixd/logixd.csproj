<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>logixd</AssemblyName>
    <RootNamespace>Logixd</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK client. Resolved from the local package source the SDK
         installer drops next to its examples; see nuget.config. -->
    <PackageReference Include="RockwellAutomation.LogixDesigner.CSClient" Version="2.2.*" />
  </ItemGroup>

</Project>
