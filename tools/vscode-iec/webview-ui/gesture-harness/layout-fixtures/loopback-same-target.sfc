PROGRAM P
VAR_EXTERNAL
    Go : BOOL; Done : BOOL; Again : BOOL; Abort : BOOL; Retry : BOOL; Fault : BOOL; X : BOOL;
END_VAR
SFC
  INITIAL_STEP Idle:
  END_STEP
  STEP S1:
  END_STEP
  STEP S2:
  END_STEP
  STEP S3:
  END_STEP
  TRANSITION t1 FROM Idle TO S1 := Go;
  END_TRANSITION
  TRANSITION t2 FROM S1 TO S2 := Go;
  END_TRANSITION
  TRANSITION t3 FROM S2 TO S3 := Go;
  END_TRANSITION
  TRANSITION t_s3_back FROM S3 TO Idle := Done;
  END_TRANSITION
  TRANSITION t_s3_abort FROM S3 TO Idle := Abort;
  END_TRANSITION
  TRANSITION t_s3_retry FROM S3 TO Idle := Retry;
  END_TRANSITION
  TRANSITION t_s3_fault_with_a_really_quite_long_transition_name FROM S3 TO Idle := Fault;
  END_TRANSITION
  TRANSITION t_s3_x FROM S3 TO S1 := X;
  END_TRANSITION
END_SFC
END_PROGRAM
