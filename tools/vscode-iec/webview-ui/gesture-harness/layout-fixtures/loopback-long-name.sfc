PROGRAM P
VAR_EXTERNAL
    Go : BOOL; Done : BOOL; Again : BOOL; Abort : BOOL; Retry : BOOL; Fault : BOOL; X : BOOL;
END_VAR
SFC
  INITIAL_STEP Idle:
  END_STEP
  STEP Run:
  END_STEP
  TRANSITION t_go FROM Idle TO Run := Go;
  END_TRANSITION
  TRANSITION t_an_extremely_long_transition_name_that_goes_on_and_on_and_on FROM Run TO Idle := X;
  END_TRANSITION
END_SFC
END_PROGRAM
