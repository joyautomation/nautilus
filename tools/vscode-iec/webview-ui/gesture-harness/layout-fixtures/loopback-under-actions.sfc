PROGRAM P
VAR_EXTERNAL
    Go : BOOL; Done : BOOL; Again : BOOL; Abort : BOOL; Retry : BOOL; Fault : BOOL; X : BOOL;
END_VAR
SFC
  INITIAL_STEP Idle:
  END_STEP
  STEP S1:
    N Go;
    N Done;
    N Again;
  END_STEP
  STEP S2:
  END_STEP
  TRANSITION t1 FROM Idle TO S1 := Go;
  END_TRANSITION
  TRANSITION t2 FROM S1 TO S2 := Go;
  END_TRANSITION
  TRANSITION t_s1_back FROM S1 TO Idle := Abort;
  END_TRANSITION
  TRANSITION t_s2_back FROM S2 TO Idle := Done;
  END_TRANSITION
END_SFC
END_PROGRAM
