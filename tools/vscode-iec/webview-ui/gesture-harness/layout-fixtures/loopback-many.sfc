PROGRAM P
VAR_EXTERNAL
    Go : BOOL; Done : BOOL; Again : BOOL; Abort : BOOL; Retry : BOOL; Fault : BOOL; X : BOOL;
END_VAR
SFC
  INITIAL_STEP Idle:
  END_STEP
  STEP S1:
  END_STEP
  STEP S2:
  END_STEP
  TRANSITION t1 FROM Idle TO S1 := Go;
  END_TRANSITION
  TRANSITION t_a FROM S1 TO Idle := Abort;
  END_TRANSITION
  TRANSITION t_b FROM S1 TO Idle := Retry;
  END_TRANSITION
  TRANSITION t_c FROM S1 TO Idle := Fault;
  END_TRANSITION
  TRANSITION t_d FROM S1 TO Idle := X;
  END_TRANSITION
  TRANSITION t_e FROM S1 TO Idle := Again;
  END_TRANSITION
  TRANSITION t2 FROM S1 TO S2 := Go;
  END_TRANSITION
END_SFC
END_PROGRAM
