{
  "name": "vscode-iec",
  "displayName": "nautilus IEC 61131-3",
  "description": "IEC 61131-3 language support for the nautilus SCADA framework: Structured Text (.st), Function Block Diagram (.fbd), Ladder Diagram (.ld) and Sequential Function Chart (.sfc) with syntax highlighting, compile diagnostics, go-to-definition, live graphical diagram editors, inline live tag values from a running controller, and a graphical HMI mimic editor for *.mimic.json P&ID documents.",
  "version": "0.11.0",
  "publisher": "joyauto",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "iec 61131-3",
    "structured text",
    "plc",
    "scada",
    "hmi",
    "nautilus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyautomation/nautilus.git",
    "directory": "tools/vscode-iec"
  },
  "homepage": "https://github.com/joyautomation/nautilus/tree/main/tools/vscode-iec#readme",
  "bugs": {
    "url": "https://github.com/joyautomation/nautilus/issues"
  },
  "main": "./out/extension.js",
  "nautilusCli": {
    "minVersion": "0.11.0"
  },
  "activationEvents": [
    "onLanguage:iec-st",
    "onLanguage:iec-fbd",
    "onLanguage:iec-ld",
    "onLanguage:iec-sfc",
    "workspaceContains:**/nautilus.yaml",
    "workspaceContains:**/*_test.yaml",
    "onLanguage:logix-l5x"
  ],
  "contributes": {
    "languages": [
      {
        "id": "iec-st",
        "aliases": [
          "Structured Text",
          "IEC 61131-3 Structured Text",
          "iec-st"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/st-dark.svg",
          "light": "./icons/st-light.svg"
        }
      },
      {
        "id": "iec-fbd",
        "aliases": [
          "Function Block Diagram",
          "IEC 61131-3 Function Block Diagram",
          "iec-fbd"
        ],
        "extensions": [
          ".fbd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/fbd-dark.svg",
          "light": "./icons/fbd-light.svg"
        }
      },
      {
        "id": "iec-ld",
        "aliases": [
          "Ladder Diagram",
          "IEC 61131-3 Ladder Diagram",
          "iec-ld"
        ],
        "extensions": [
          ".ld"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/ld-dark.svg",
          "light": "./icons/ld-light.svg"
        }
      },
      {
        "id": "iec-sfc",
        "aliases": [
          "Sequential Function Chart",
          "IEC 61131-3 Sequential Function Chart",
          "iec-sfc"
        ],
        "extensions": [
          ".sfc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/sfc-dark.svg",
          "light": "./icons/sfc-light.svg"
        }
      },
      {
        "id": "logix-l5x",
        "aliases": [
          "Logix L5X Export",
          "L5X"
        ],
        "extensions": [
          ".L5X",
          ".l5x"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/ld-dark.svg",
          "light": "./icons/ld-light.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "iec-st",
        "scopeName": "source.iec-st",
        "path": "./syntaxes/iec-st.tmLanguage.json"
      },
      {
        "language": "iec-fbd",
        "scopeName": "source.iec-fbd",
        "path": "./syntaxes/iec-fbd.tmLanguage.json"
      },
      {
        "language": "iec-ld",
        "scopeName": "source.iec-ld",
        "path": "./syntaxes/iec-ld.tmLanguage.json"
      },
      {
        "language": "iec-sfc",
        "scopeName": "source.iec-sfc",
        "path": "./syntaxes/iec-sfc.tmLanguage.json"
      },
      {
        "scopeName": "nautilus.injection.test-yaml",
        "path": "./syntaxes/nautilus-test.injection.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ],
    "commands": [
      {
        "command": "nautilus.liveValues.toggle",
        "title": "nautilus: Toggle Inline Live Tag Values"
      },
      {
        "command": "nautilus.installCli",
        "title": "nautilus: Install or Update the naut CLI"
      },
      {
        "command": "nautilus.showCliInfo",
        "title": "nautilus: Show CLI Info"
      },
      {
        "command": "nautilus.restartLanguageServer",
        "title": "nautilus: Restart Language Server"
      },
      {
        "command": "nautilus.connect",
        "title": "nautilus: Connect to Controller…"
      },
      {
        "command": "nautilus.setValue",
        "title": "nautilus: Set Live Value…",
        "icon": "$(edit)"
      },
      {
        "command": "nautilus.liveValues.refresh",
        "title": "nautilus: Refresh Live Values",
        "icon": "$(refresh)"
      },
      {
        "command": "nautilus.program.download",
        "title": "nautilus: Download Program to Controller"
      },
      {
        "command": "nautilus.program.diff",
        "title": "nautilus: Diff Program with Controller"
      },
      {
        "command": "nautilus.program.rollback",
        "title": "nautilus: Rollback Controller Program"
      },
      {
        "command": "nautilus.program.pull",
        "title": "nautilus: Pull Program from Controller"
      },
      {
        "command": "nautilus.fbd.preview",
        "title": "nautilus: Open FBD Diagram Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "nautilus.ld.preview",
        "title": "nautilus: Open Ladder Diagram Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "nautilus.sfc.preview",
        "title": "nautilus: Open SFC Diagram Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "nautilus.fbd.diff",
        "title": "nautilus: Diff FBD Diagram (vs git HEAD)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.fbd.diffController",
        "title": "nautilus: Diff FBD Diagram (vs Controller)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.fbd.diffRevisions",
        "title": "nautilus: Diff FBD Diagram (between git revisions…)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.ld.diff",
        "title": "nautilus: Diff Ladder Diagram (vs git HEAD)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.ld.diffController",
        "title": "nautilus: Diff Ladder Diagram (vs Controller)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.ld.diffRevisions",
        "title": "nautilus: Diff Ladder Diagram (between git revisions…)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.sfc.diff",
        "title": "nautilus: Diff SFC Diagram (vs git HEAD)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.sfc.diffController",
        "title": "nautilus: Diff SFC Diagram (vs Controller)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.sfc.diffRevisions",
        "title": "nautilus: Diff SFC Diagram (between git revisions…)",
        "icon": "$(diff)"
      },
      {
        "command": "nautilus.editComponentPorts",
        "title": "Nautilus: Edit Component Ports…"
      },
      {
        "command": "nautilus.newProject",
        "title": "nautilus: Create Project…"
      },
      {
        "command": "nautilus.getStarted",
        "title": "nautilus: Get Started"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nautilus",
          "title": "nautilus",
          "icon": "icons/live-values.svg"
        }
      ]
    },
    "views": {
      "nautilus": [
        {
          "id": "nautilusLiveValues",
          "name": "Live Values",
          "contextualTitle": "nautilus"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nautilusLiveValues",
        "contents": "No live values yet \u2014 start a controller with `naut run`, or point the editor at one.\n[Connect to Controller](command:nautilus.connect)\nValues stream over the same API the inline pills use."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nautilus.connect",
          "when": "view == nautilusLiveValues",
          "group": "navigation@1"
        },
        {
          "command": "nautilus.liveValues.refresh",
          "when": "view == nautilusLiveValues",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nautilus.setValue",
          "when": "view == nautilusLiveValues && viewItem == nautilusTag",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "nautilus.setValue",
          "when": "resourceLangId == iec-st || resourceLangId == iec-fbd || resourceLangId == iec-ld || resourceLangId == iec-sfc",
          "group": "nautilus@1"
        }
      ],
      "editor/title": [
        {
          "command": "nautilus.fbd.preview",
          "when": "resourceLangId == iec-fbd",
          "group": "navigation"
        },
        {
          "command": "nautilus.ld.preview",
          "when": "resourceLangId == iec-ld",
          "group": "navigation"
        },
        {
          "command": "nautilus.sfc.preview",
          "when": "resourceLangId == iec-sfc",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nautilus.liveValues.refresh",
          "when": "false"
        },
        {
          "command": "nautilus.fbd.preview",
          "when": "resourceLangId == iec-fbd"
        },
        {
          "command": "nautilus.ld.preview",
          "when": "resourceLangId == iec-ld || resourceLangId == logix-l5x"
        },
        {
          "command": "nautilus.sfc.preview",
          "when": "resourceLangId == iec-sfc"
        },
        {
          "command": "nautilus.fbd.diff",
          "when": "resourceLangId == iec-fbd"
        },
        {
          "command": "nautilus.fbd.diffController",
          "when": "resourceLangId == iec-fbd"
        },
        {
          "command": "nautilus.fbd.diffRevisions",
          "when": "resourceLangId == iec-fbd"
        },
        {
          "command": "nautilus.ld.diff",
          "when": "resourceLangId == iec-ld || resourceLangId == logix-l5x"
        },
        {
          "command": "nautilus.ld.diffController",
          "when": "resourceLangId == iec-ld"
        },
        {
          "command": "nautilus.ld.diffRevisions",
          "when": "resourceLangId == iec-ld || resourceLangId == logix-l5x"
        },
        {
          "command": "nautilus.sfc.diff",
          "when": "resourceLangId == iec-sfc"
        },
        {
          "command": "nautilus.sfc.diffController",
          "when": "resourceLangId == iec-sfc"
        },
        {
          "command": "nautilus.sfc.diffRevisions",
          "when": "resourceLangId == iec-sfc"
        }
      ]
    },
    "configuration": {
      "title": "nautilus IEC 61131-3",
      "properties": {
        "nautilus.cliPath": {
          "type": "string",
          "default": "naut",
          "description": "The nautilus CLI, `naut` (provides the language server via `naut lsp`, and the diagram editors). Easiest: run \"nautilus: Install or Update the naut CLI\" and leave this as `naut`. The command is `naut`, not `nautilus` -- GNOME's file manager owns that name on Linux. A bare name is looked up on PATH, then in the copy the install command manages, then $GOBIN, $GOPATH/bin, ~/go/bin, ~/.local/bin, /usr/local/bin, /opt/homebrew/bin (%LOCALAPPDATA%\\nautilus on Windows); set a full path to skip the search."
        },
        "nautilus.runtimeUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of a running nautilus controller's tag API. Inline live values subscribe to <url>/api/stream."
        },
        "nautilus.liveValues.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show live tag values inline next to identifiers in .st files when a controller is reachable."
        },
        "nautilus.token": {
          "type": "string",
          "default": "",
          "markdownDescription": "Bearer token for writes to a token-gated controller (matches the controller's `NAUTILUS_TOKEN`). Needed only for online-edit download/rollback against a controller started with a token \u2014 reads and `naut pull` never require it. Prefer setting this in workspace settings, not user settings."
        },
        "nautilus.mimic.snapToGrid": {
          "type": "boolean",
          "default": true,
          "description": "Snap dragged equipment, labels and pipe vertices to the grid in the Mimic Editor. Also toggleable from the editor's toolbar. Shift-arrow nudging always snaps regardless of this setting."
        },
        "nautilus.confirmControllerWrites": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before Download Program to Controller or Rollback Controller Program change what a running controller is executing. Turn this off only when iterating against a local simulator you're sure of — a tunneled nautilus.runtimeUrl can still point at a real plant, so leave it on for anything that might be live."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "nautilus.fbdDiagram",
        "displayName": "FBD Diagram",
        "selector": [
          {
            "filenamePattern": "*.fbd"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "nautilus.ldDiagram",
        "displayName": "Ladder Diagram",
        "selector": [
          {
            "filenamePattern": "*.ld"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "nautilus.l5xDiagram",
        "displayName": "Ladder Diagram (Logix L5X)",
        "selector": [
          {
            "filenamePattern": "*.L5X"
          },
          {
            "filenamePattern": "*.l5x"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "nautilus.sfcDiagram",
        "displayName": "SFC Diagram",
        "selector": [
          {
            "filenamePattern": "*.sfc"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "nautilus.mimicEditor",
        "displayName": "Mimic Editor",
        "selector": [
          {
            "filenamePattern": "*.mimic.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "nautilus.componentEditor",
        "displayName": "Component Editor",
        "selector": [
          {
            "filenamePattern": "*.component.json"
          }
        ],
        "priority": "default"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*_test.yaml",
        "url": "./schemas/nautilus-test.schema.json"
      },
      {
        "fileMatch": "nautilus.yaml",
        "url": "./schemas/nautilus.schema.json"
      },
      {
        "fileMatch": "sites/*.yaml",
        "url": "./schemas/nautilus.schema.json"
      },
      {
        "fileMatch": "tags/*.yaml",
        "url": "./schemas/nautilus-tags.schema.json"
      },
      {
        "fileMatch": "alarms/*.yaml",
        "url": "./schemas/nautilus-alarms.schema.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with nautilus",
        "description": "Zero to a running controller with live values on a diagram — no Go toolchain, about five minutes.",
        "icon": "icon.png",
        "steps": [
          {
            "id": "installCli",
            "title": "Install the naut CLI",
            "description": "Install `naut` — the whole nautilus toolchain: scaffolding, the scan loop, tests, and the language server this extension uses — with no Go toolchain required.\nIf `naut` is already on your PATH (or from `go install`), the extension finds and uses it automatically; this step is a no-op for you.",
            "media": {
              "markdown": "walkthroughs/gettingStarted/installCli.md"
            },
            "completionEvents": [
              "onCommand:nautilus.installCli"
            ]
          },
          {
            "id": "createProject",
            "title": "Create a project",
            "description": "Scaffold a runnable controller with `naut new` — a manifest, IEC program files, and an acceptance test, no Go required.\nThe default **Demo** template is a 3-task, 3-language tour with a simulated plant, so it does something the moment it runs.",
            "media": {
              "markdown": "walkthroughs/gettingStarted/createProject.md"
            },
            "completionEvents": [
              "onCommand:nautilus.newProject",
              "onContext:nautilus.hasProject"
            ]
          },
          {
            "id": "openDiagram",
            "title": "Open a diagram",
            "description": "Open `program.fbd` — the Demo template's control logic — and switch it to the diagram view: right-click the file and choose **Open With → FBD Diagram**, or click the diagram icon in the editor title bar.\nLadder (`.ld`) and Sequential Function Chart (`.sfc`) files open the same way.",
            "media": {
              "markdown": "walkthroughs/gettingStarted/openDiagram.md"
            },
            "completionEvents": [
              "onCommand:nautilus.fbd.preview",
              "onCommand:nautilus.ld.preview",
              "onCommand:nautilus.sfc.preview"
            ]
          },
          {
            "id": "runAndConnect",
            "title": "Run it",
            "description": "In a terminal at the project root, run `naut run` — it starts the scan loop and a tag API on `http://localhost:8080`.\nThen connect the editor to it: live values render as inline pills next to every identifier, and diagrams animate power flow in real time.",
            "media": {
              "image": "images/live-values.png",
              "altText": "Live tag values rendered as pills next to identifiers in a .st file, with the nautilus file tree alongside"
            },
            "completionEvents": [
              "onCommand:nautilus.connect",
              "onCommand:nautilus.liveValues.toggle"
            ]
          },
          {
            "id": "testIt",
            "title": "Test it",
            "description": "Acceptance tests (`*_test.yaml`) assert on tag values over a virtual clock, so a 10-second alarm delay is asserted exactly, in milliseconds — no real waiting.\nOpen the **Testing** view in the Activity Bar to see the Demo project's suite, or run `naut test` from a terminal.",
            "media": {
              "markdown": "walkthroughs/gettingStarted/testIt.md"
            },
            "completionEvents": [
              "onCommand:testing.runAll",
              "onCommand:workbench.view.testing.focus"
            ]
          }
        ]
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Rendering user-authored Svelte components inside the mimic/Component Editor compiles project code with esbuild and the workspace's own toolchain (svelte/compiler, node_modules). This is disabled in untrusted workspaces — the built-in kit components and placeholder chips still work fully."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/scan.test.js out/cliResolve.test.js out/cliInstall.test.js out/gitHistory.test.js out/programSync.test.js out/onlineEditConfirm.test.js out/mimicOps.test.js out/mimicComponentIndex.test.js out/userComponentBuild.test.js out/l5xRouting.test.js out/previewFollow.test.js out/newProjectLogic.test.js && npm --prefix webview-ui run test",
    "build:webview": "npm --prefix webview-ui run build",
    "test:e2e": "npm run compile && node out/e2e/run.js"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.82.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.4.0"
  }
}
