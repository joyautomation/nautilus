{
  "comments": {
    "lineComment": "//",
    "blockComment": ["(*", "*)"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(*", "close": "*)" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["'", "'"]
  ],
  "autoCloseBefore": ";:.,=}])' \n\t",
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "folding": {
    "markers": {
      "start": "^\\s*[Rr][Ee][Gg][Ii][Oo][Nn]\\b(?!\\s*(:=|\\.|\\[|\\(|;))",
      "end": "^\\s*[Ee][Nn][Dd]_[Rr][Ee][Gg][Ii][Oo][Nn]\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(?i)\\b(PROGRAM|FUNCTION|FUNCTION_BLOCK|VAR|VAR_INPUT|VAR_OUTPUT|VAR_IN_OUT|VAR_TEMP|VAR_GLOBAL|VAR_EXTERNAL|TYPE|STRUCT|IF|ELSIF|ELSE|FOR|WHILE|REPEAT|CASE|SFC|INITIAL_STEP|STEP|TRANSITION|ACTION)\\b(?!.*\\b(END_IF|END_FOR|END_WHILE|END_REPEAT|END_CASE|END_STEP|END_TRANSITION|END_ACTION)\\b)",
    "decreaseIndentPattern": "(?i)^\\s*\\b(END_PROGRAM|END_FUNCTION|END_FUNCTION_BLOCK|END_VAR|END_TYPE|END_STRUCT|END_IF|ELSIF|ELSE|END_FOR|END_WHILE|END_REPEAT|END_CASE|UNTIL|END_SFC|END_STEP|END_TRANSITION|END_ACTION)\\b"
  }
}
