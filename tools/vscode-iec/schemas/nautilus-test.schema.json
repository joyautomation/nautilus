{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nautilus acceptance tests",
  "description": "Acceptance tests for control logic, run by `nautilus test` on a virtual clock. The fixture comes from nautilus.yaml, so tasks, scan rates, tag roles and seeds are never restated here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tests"
  ],
  "properties": {
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Default \u00b1 for `near` matchers in this file. A test may override it."
    },
    "suspend": {
      "$ref": "#/definitions/suspend",
      "description": "Tasks frozen in every test in this file. A test's own `suspend` replaces this list."
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/test"
      }
    }
  },
  "definitions": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "One named scenario: initial conditions, then steps. A test with no `steps:` is itself one step.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The identity in output and in `nautilus test -run` patterns. Must be unique in the file."
        },
        "suspend": {
          "$ref": "#/definitions/suspend"
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Default \u00b1 for `near` matchers in this test."
        },
        "given": {
          "$ref": "#/definitions/given",
          "description": "Initial conditions, applied before the first scan."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/step"
          },
          "description": "The test's steps. Mutually exclusive with the single-step keys below."
        },
        "scans": {
          "$ref": "#/definitions/scans"
        },
        "advance": {
          "$ref": "#/definitions/advance"
        },
        "until": {
          "$ref": "#/definitions/until"
        },
        "hold": {
          "$ref": "#/definitions/hold"
        },
        "expect": {
          "$ref": "#/definitions/expect"
        },
        "always": {
          "$ref": "#/definitions/always"
        }
      },
      "not": {
        "allOf": [
          {
            "required": [
              "steps"
            ]
          },
          {
            "anyOf": [
              {
                "required": [
                  "scans"
                ]
              },
              {
                "required": [
                  "advance"
                ]
              },
              {
                "required": [
                  "until"
                ]
              },
              {
                "required": [
                  "hold"
                ]
              },
              {
                "required": [
                  "expect"
                ]
              },
              {
                "required": [
                  "always"
                ]
              }
            ]
          }
        ]
      },
      "errorMessage": "use either `steps:` or the single-step keys, not both",
      "dependencies": {
        "hold": {
          "required": [
            "until"
          ],
          "description": "`hold` says how long the expectation must stay true, which only means something with `until`."
        },
        "until": {
          "required": [
            "expect"
          ]
        },
        "scans": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "advance"
                ]
              },
              {
                "required": [
                  "until"
                ]
              }
            ]
          }
        },
        "advance": {
          "not": {
            "required": [
              "until"
            ]
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional writes, a span of virtual time, and what must be true. Takes at most one of scans/advance/until.",
      "properties": {
        "given": {
          "$ref": "#/definitions/given"
        },
        "scans": {
          "$ref": "#/definitions/scans"
        },
        "advance": {
          "$ref": "#/definitions/advance"
        },
        "until": {
          "$ref": "#/definitions/until"
        },
        "hold": {
          "$ref": "#/definitions/hold"
        },
        "expect": {
          "$ref": "#/definitions/expect"
        },
        "always": {
          "$ref": "#/definitions/always"
        }
      },
      "dependencies": {
        "hold": {
          "required": [
            "until"
          ],
          "description": "`hold` says how long the expectation must stay true, which only means something with `until`."
        },
        "until": {
          "required": [
            "expect"
          ]
        },
        "scans": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "advance"
                ]
              },
              {
                "required": [
                  "until"
                ]
              }
            ]
          }
        },
        "advance": {
          "not": {
            "required": [
              "until"
            ]
          }
        }
      }
    },
    "suspend": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Task names that do not scan. Freezing the task that simulates the plant is what turns a closed-loop project into an open-loop test."
    },
    "given": {
      "type": "object",
      "minProperties": 1,
      "description": "Tag writes, routed by the role declared in nautilus.yaml: a role:input tag goes to the driver's input image and arrives at the top of the next scan; everything else is written straight to the tag store.",
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string"
        ]
      }
    },
    "scans": {
      "type": "integer",
      "minimum": 0,
      "description": "Run until the main task has completed N more scans \u2014 the honest unit for combinational logic, where one scan is the whole question."
    },
    "advance": {
      "$ref": "#/definitions/duration",
      "description": "Run every scan due within this much virtual time, then land the clock exactly there. Exact, not rounded."
    },
    "until": {
      "$ref": "#/definitions/duration",
      "description": "Run up to this long, stopping as soon as `expect` holds. Fails if it never does."
    },
    "hold": {
      "$ref": "#/definitions/duration",
      "description": "With `until`: how long the expectation must stay true to count. A loop that merely passes through its target has not settled."
    },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+|[0-9]*\\.[0-9]+)(ns|us|\u00b5s|ms|s|m|h)(([0-9]+|[0-9]*\\.[0-9]+)(ns|us|\u00b5s|ms|s|m|h))*$",
      "description": "A Go duration: 500ms, 9.5s, 2m, 1m30s."
    },
    "expect": {
      "$ref": "#/definitions/expectation",
      "description": "Checked at the end of the step \u2014 or, with `until`, at every tick until it holds."
    },
    "always": {
      "$ref": "#/definitions/expectation",
      "description": "Checked after EVERY scan in the step. Invariants, not endpoints \u2014 a clamp that must never break, an alarm that must never trip."
    },
    "expectation": {
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/matcher"
          },
          "description": "Tag matchers, keyed by tag name (or task.local for a program's retained state)."
        },
        {
          "type": "string",
          "minLength": 1,
          "description": "An ST boolean expression, compiled by the same compiler as your logic \u2014 e.g. ABS(TempC - TempSP) < 0.5. Reusable predicates go in a library file as a FUNCTION returning BOOL."
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "$ref": "#/definitions/matcher"
                }
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "description": "A list mixing tag matchers and ST expressions. All must hold."
        }
      ]
    },
    "matcher": {
      "anyOf": [
        {
          "type": [
            "boolean",
            "string",
            "number"
          ],
          "description": "Exact equality."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "eq": {
              "type": [
                "boolean",
                "string",
                "number"
              ],
              "description": "Exact equality, spelled out."
            },
            "near": {
              "type": "number",
              "description": "Within `tol` of this value (or the file/test `tolerance`)."
            },
            "tol": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "The \u00b1 for `near`. Defaults to the test's or the file's `tolerance`."
            },
            "gt": {
              "type": "number"
            },
            "ge": {
              "type": "number"
            },
            "lt": {
              "type": "number"
            },
            "le": {
              "type": "number"
            },
            "between": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Inclusive range, [low, high]."
            }
          },
          "dependencies": {
            "tol": {
              "required": [
                "near"
              ],
              "description": "`tol` belongs with `near`."
            }
          }
        }
      ]
    }
  }
}
