PROGRAM Main
VAR_EXTERNAL
    FT101_Raw : INT;
    FT101_Flow : REAL;
    StartA : BOOL;
    StopAll : BOOL;
    MainDtS : REAL;
    RecipeA : DoseRecipe;
    XV101_Open : BOOL;
    DoseFault : BOOL;
    DoneLamp : BOOL;
    DoseStep : INT;
    MaxFlowLpm : REAL;
    FCV101_SP : REAL;
    HighFlowAlm : BOOL;
    ResetCount : BOOL;
    DosesToday : INT;
END_VAR
FBD
  NETWORK 'FT-101 raw analog to L/min (FC105-style scaling)'
  ft = ScaleAnalog(FT101_Raw, 0.0, 120.0)
  FT101_Flow := ft
  NETWORK 'dosing line A, its instance data in doseA'
  doseA : Dosing(Start := StartA, Stop := StopAll, FlowLpm := FT101_Flow, Dt := MainDtS, Recipe := RecipeA)
  XV101_Open := doseA.ValveOpen
  DoseFault := doseA.Fault
  DoneLamp := doseA.Done
  DoseStep := doseA.Step
  NETWORK 'FCV-101 flow setpoint, clamped, zero while the valve is shut'
  spA = LIMIT(0.0, RecipeA.FlowSP, MaxFlowLpm)
  spOut = SEL(doseA.ValveOpen, 0.0, spA)
  FCV101_SP := spOut
  NETWORK 'high-flow alarm, 2 s on-delay'
  hiFlow = GT(FT101_Flow, MaxFlowLpm)
  tHi : TON(IN := hiFlow, PT := T#2S)
  HighFlowAlm := tHi.Q
  NETWORK 'doses today'
  cDoses : CTU(CU := doseA.Done, R := ResetCount, PV := 1000)
  DosesToday := cDoses.CV
END_FBD
END_PROGRAM
