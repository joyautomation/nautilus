PROGRAM TankBatch
(* Batch tank sequence: fill, then heat and mix at the same time
   (simultaneous divergence), drain once BOTH are done (simultaneous
   convergence), count the batch. Abort has priority out of Fill. The tank
   itself is plant.st. *)
VAR_EXTERNAL
    (* field inputs *)
    Level      : REAL;  (* tank level, % *)
    TempC      : REAL;  (* tank temperature *)
    (* operator/auto-operator inputs *)
    Start      : BOOL;  (* plant.st asserts this whenever the batch is idle *)
    Abort      : BOOL;  (* wired, always FALSE from the auto-operator *)
    (* setpoints *)
    FillSP     : REAL;
    EmptySP    : REAL;
    HeatSP     : REAL;
    (* field outputs *)
    FillValve  : BOOL;
    DrainValve : BOOL;
    Heater     : BOOL;
    Mixer      : BOOL;
    RunLamp    : BOOL;
    AbortLamp  : BOOL;
    BatchCount : INT;
END_VAR
VAR
    mixT : TON;   (* referenced by the Mix action body *)
END_VAR
SFC

  INITIAL_STEP Idle:
    N  RunLamp;               (* boolean action: RunLamp := Idle.X OR ... *)
    R  AbortLamp;              (* clear the abort lamp on return to Idle *)
  END_STEP

  STEP Fill:
    N  RunLamp;
    N  FillValve;              (* valve open while Fill active *)
  END_STEP

  STEP Heat:
    N  RunLamp;
    N  HeatCtrl;               (* ACTION block, below — a real thermostat *)
  END_STEP

  STEP Mix:
    N  RunLamp;
    N  Stir;                   (* ACTION block, below *)
  END_STEP

  STEP Drain:
    N   RunLamp;
    N   DrainValve;
    P1  CountBatch;             (* pulse: run its body once on activation *)
  END_STEP

  STEP Aborted:
    S  AbortLamp;               (* latched abort indicator — RunLamp drops *)
  END_STEP

  (* --- transitions --- *)

  TRANSITION t_start FROM Idle TO Fill := Start AND NOT Abort;
  END_TRANSITION

  (* alternative divergence out of Fill: abort has priority (declared first) *)
  TRANSITION t_abort FROM Fill TO Aborted := Abort;
  END_TRANSITION
  TRANSITION t_full  FROM Fill TO (Heat, Mix) := Level >= FillSP;   (* simultaneous divergence *)
  END_TRANSITION

  (* simultaneous convergence: fires only when BOTH Heat and Mix are active *)
  TRANSITION t_done FROM (Heat, Mix) TO Drain := (TempC >= HeatSP) AND mixT.Q;
  END_TRANSITION

  TRANSITION t_empty  FROM Drain   TO Idle    := Level <= EmptySP;
  END_TRANSITION
  TRANSITION t_resume FROM Aborted TO Idle    := NOT Abort;
  END_TRANSITION

  (* --- action blocks (ST bodies) --- *)

  ACTION HeatCtrl:
    (* "Heater until TempC >= HeatSP": Heat stays active for the whole
       simultaneous branch (t_done also waits on the Mix timer), but the
       heater itself is a thermostat — it drops out at setpoint instead of
       cooking the batch for the rest of the mix time. *)
    Heater := Heat.X AND (TempC < HeatSP);
  END_ACTION

  ACTION Stir:
    Mixer := Mix.X;                  (* track the step: drops to FALSE on the final scan *)
    mixT(IN := Mix.X, PT := T#8S);    (* mixing timer; falling edge resets it *)
  END_ACTION

  ACTION CountBatch:
    BatchCount := BatchCount + 1;     (* runs exactly once, on Drain activation *)
  END_ACTION

END_SFC
END_PROGRAM
