<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Seal-in with a stop, and a latched maintenance flag alongside]]>
</Comment>
<Text>
<![CDATA[[XIC(StartPB) ,XIC(RunCmd) ]XIO(StopPB)OTE(RunCmd);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Nested branches, a one-shot, and an unset timer operand]]>
</Comment>
<Text>
<![CDATA[[XIC(Remote) [XIO(Auto) ,XIC(Interlock) ] ,XIC(Local) ONS(StartOS) ]TON(DwellTmr,?,?)OTE(Dwelling);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Parallel outputs, which Logix writes as a branch of coils]]>
</Comment>
<Text>
<![CDATA[XIC(DwellTmr.DN)[OTE(Ready) ,OTL(Maint) ,OTU(Fault) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Boxes on the rung: a compare, a move, and an expression]]>
</Comment>
<Text>
<![CDATA[GEQ(P101_Level.EU,P101_Level.Alarms.Hi)MOV(1,Scratch)CPT(RunHours,(RunHours + 1) / 2)OTE(HiAlm);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Ready)Pump_Control(P101,StartPB,RunCmd)OTE(Started);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Calcs" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Scratch := Scratch + 1;]]>
</Line>
<Line Number="1">
<![CDATA[IF Scratch > MaxStarts THEN Scratch := 0; END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks/>
